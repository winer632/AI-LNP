# AI-LNP environment template.
#
# Copy to `.env` and fill in the values you need:
#     cp .env.example .env
# `.env` is git-ignored and must never be committed.
#
# Nothing here is needed to run the test suite. `pytest` must never reach a
# paid API, so CI runs with the API keys explicitly blanked:
#     OPENAI_API_KEY= SENSENOVA_API_KEY= .venv/bin/python -m pytest -q
#
# "Required" below means required for the stage named in the comment, not for
# the repository as a whole. Every model variable has a working default in code;
# set one only to pin or override the model for that stage.


# ---------------------------------------------------------------------------
# OpenAI-compatible API (compact extraction, repair, vision, recovery)
# ---------------------------------------------------------------------------

# Required for every paid OpenAI-compatible call. Leave blank to make any such
# call fail fast instead of spending money by accident.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Optional. Endpoint for the OpenAI-compatible client.
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Legacy variable name that the PaperQA benchmark sets and reads for
# libraries that do not honour OPENAI_BASE_URL. Keep it consistent with
# OPENAI_BASE_URL when you override the endpoint.
OPENAI_API_BASE=https://api.openai.com/v1


# ---------------------------------------------------------------------------
# SenseNova API (abstract-first and G1 v2/v3/v4 extraction routes)
# ---------------------------------------------------------------------------

# Required for the SenseNova routes. Leave blank to disable them safely.
SENSENOVA_API_KEY=replace_with_your_sensenova_api_key

# Optional. Default: https://token.sensenova.cn/v1
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# Optional. Default: sensenova-6.7-flash-lite
SENSENOVA_MODEL=sensenova-6.7-flash-lite


# ---------------------------------------------------------------------------
# Literature discovery
# ---------------------------------------------------------------------------

# Required for PubMed / NCBI E-utilities discovery runs. NCBI asks every client
# to identify itself; unattributed traffic gets rate-limited or blocked.
NCBI_EMAIL=replace_with_your_contact_email


# ---------------------------------------------------------------------------
# Document parsing service (feature flag: uniparse_ingestion, P0-a)
# ---------------------------------------------------------------------------

# Required only when AI_LNP_FLAG_UNIPARSE_INGESTION=true. Base URL of the
# UniParse structural document parsing service.
UNIPARSE_BASE_URL=http://100.67.181.118:8020


# ---------------------------------------------------------------------------
# Full-text RAG route model selection (all optional)
# ---------------------------------------------------------------------------

# Which provider the RAG experiment extraction uses: `sensenova` or `openai`.
# Default: sensenova
RAG_LLM_PROVIDER=sensenova

# Model id used by the PaperQA benchmark. Default: openai/deepseek-v4-flash
RAG_LLM_MODEL=openai/deepseek-v4-flash

# Extractor model for RAG experiment extraction.
# Default: gpt-5.6-sol (openai provider) / deepseek-v4-flash (sensenova provider)
RAG_EXTRACTION_MODEL=

# Verifier model for RAG experiment extraction.
# Default: gpt-5.6-terra (openai provider) / glm-5.2 (sensenova provider)
RAG_VERIFIER_MODEL=

# Seconds to wait between papers in the PaperQA benchmark, to stay inside
# provider rate limits. Default: 15
PAPERQA_INTER_PAPER_DELAY=15


# ---------------------------------------------------------------------------
# Compact extraction route model selection (all optional)
# ---------------------------------------------------------------------------

# First structured extraction call. Default: gpt-5.6-terra
COMPACT_EXTRACTION_MODEL=gpt-5.6-terra

# Bounded single-field text repair. Default: gpt-5.6-terra
NARROW_REPAIR_MODEL=gpt-5.6-terra

# Targeted table/figure vision referral. Default: gpt-5.6-terra
SELECTIVE_VISION_MODEL=gpt-5.6-terra

# Recovery of one missing text-supported outcome record. Default: gpt-5.6-terra
MISSING_RECORD_MODEL=gpt-5.6-terra

# Recovery of one missing visually-supported outcome record.
# Default: gpt-5.6-terra
MISSING_RECORD_VISION_MODEL=gpt-5.6-terra

# One consolidated multimodal gap-recovery call per paper.
# Default: gpt-5.6-terra
CONSOLIDATED_RECOVERY_MODEL=gpt-5.6-terra


# ---------------------------------------------------------------------------
# Feature flags (see config/feature_flags.yaml and src/config_flags.py)
# ---------------------------------------------------------------------------
#
# Every registered flag can be overridden here with AI_LNP_FLAG_<NAME>.
# Accepted values: 1/true/yes/on/enabled and 0/false/no/off/disabled.
# An empty value means "use the configured default".
# List the current registry and its effective values with:
#     .venv/bin/python -m src.config_flags
#
# AI_LNP_FLAG_UNIPARSE_INGESTION=false   # P0-a
# AI_LNP_FLAG_FULL_EVIDENCE_VIEW=false   # P0-b
# AI_LNP_FLAG_PRECISION_METRICS=false    # P1
# AI_LNP_FLAG_LOCAL_VLM_VISION=false     # P2
# AI_LNP_FLAG_EXPANDED_DISCOVERY=false   # P3
# AI_LNP_FLAG_COMPACT_ROUTE=false        # mirrors config/extraction/compact_route_v1.yaml
#
# Redirect generated reports/staging artifacts away from the working tree:
# AI_LNP_OUTPUT_ROOT=
